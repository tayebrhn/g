# ============================================================
# TCExam Production Offline Environment Settings
# ============================================================

# Web Ports (Both port 80 and port 8080 are exposed simultaneously)
APP_PORT=80
APP_ALT_PORT=8080

# Base URL (Change to http://<server-ip> or your local domain if accessing from LAN)
APP_URL=http://localhost

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=tcexam
DB_USER=tcexam
DB_PASSWORD=tcexam_secret_pass
DB_ROOT_PASSWORD=root_secret_pass

# Security Secret (Change this 64-character token for security)
RANDOM_SECURITY=f8a7c29e1d5b4a3c6e80f2149b7d8e3c1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d
