# ============================================================
# TCExam Docker Environment Configuration
# ============================================================

# Host port for the public Nginx web server
APP_PORT=8080

# Public base URL accessed by candidates and administrators
APP_URL=http://localhost:8080

# Database Settings
DB_HOST=db
DB_PORT=3306
DB_NAME=tcexam
DB_USER=tcexam
DB_PASSWORD=change_this_password_in_production
DB_ROOT_PASSWORD=change_this_root_password_in_production

# Host port mapping for local database development GUI tools (e.g. TablePlus, DBeaver)
DB_PORT_FORWARD=3307

# TCExam Security Secret (64-character random string)
# Seeds session hashes, CSRF tokens, and email verification tokens
RANDOM_SECURITY=f8a7c29e1d5b4a3c6e80f2149b7d8e3c1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d
